<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Platforms>AnyCPU;x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required by the LibraryImport P/Invoke source generator -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>reShutCLI.Program</StartupObject>
    <ApplicationIcon>reShut-CLI-centered-transparent.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <Version>2.2.1</Version>
    <AssemblyVersion>2.2.1.0</AssemblyVersion>
    <FileVersion>2.2.1.0</FileVersion>
    <Title>reShut CLI</Title>
    <Product>reShut CLI</Product>
    <Description>Command-line tool for shutdown, reboot and scheduling</Description>
    <Company>elNino0916</Company>
    <Copyright>© 2023-2026 elNino0916 and contributors.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="reShut-CLI-centered-transparent.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
  </ItemGroup>
</Project>
