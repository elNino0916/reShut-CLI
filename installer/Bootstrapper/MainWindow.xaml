<Window x:Class="reShutCLI.Bootstrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:theme="clr-namespace:reShutCLI.Bootstrapper.Theme"
        Title="reShut CLI Setup"
        Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Icon="{x:Static theme:AppIcon.Large}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                             ResizeBorderThickness="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar. Background must be explicit (not inherited/transparent) -
                 the WindowChrome CaptionHeight strip is composited by DWM as non-client
                 area, and a transparent Grid there shows the native white caption backdrop
                 through it instead of the window's dark background. -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="{x:Static theme:AppIcon.Large}" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="reShut CLI Setup" Margin="9,0,0,0" Foreground="{StaticResource FaintBrush}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClick">
                        <Path Data="M0,0 L10,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick" Margin="0,0,4,0">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3" />
                    </Button>
                </StackPanel>

                <!-- Hairline separating the caption band from the page below it. -->
                <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource FieldBorderBrush}" />
            </Grid>

            <ContentControl x:Name="ContentHost" Grid.Row="1" Focusable="False" />
        </Grid>
    </Border>
</Window>
