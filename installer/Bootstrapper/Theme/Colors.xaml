<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#FF1B1B1E</Color>
    <Color x:Key="SurfaceColor">#FF232326</Color>
    <Color x:Key="FieldColor">#FF2C2C30</Color>
    <Color x:Key="FieldBorderColor">#FF3A3A3F</Color>
    <Color x:Key="TextColor">#FFF3F3F3</Color>
    <Color x:Key="MutedColor">#FFAFAFB4</Color>
    <Color x:Key="FaintColor">#FF7C7C82</Color>
    <Color x:Key="AccentColor">#FFFF9A02</Color>
    <Color x:Key="AccentHoverColor">#FFFFAC2E</Color>
    <Color x:Key="AccentPressedColor">#FFE08600</Color>
    <Color x:Key="DangerColor">#FFE5484D</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="{StaticResource FieldBorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF1B1200" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF202024" />

    <!-- ===================== Depth ===================== -->

    <!--
        The page backdrop. A flat fill on a 520x480 window looks like a dialog box;
        the diagonal lift from top-left to bottom-right gives it a sense of surface
        without ever reading as a visible gradient.
    -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Color="#FF232228" Offset="0" />
        <GradientStop Color="#FF1B1B1E" Offset="0.55" />
        <GradientStop Color="#FF161618" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF26262B" Offset="0" />
        <GradientStop Color="#FF1D1D20" Offset="1" />
    </LinearGradientBrush>

    <!-- Rounded icon plate, lit slightly from above. -->
    <LinearGradientBrush x:Key="TileBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF33333A" Offset="0" />
        <GradientStop Color="#FF232326" Offset="1" />
    </LinearGradientBrush>

    <!-- Warm bloom placed behind the app icon on each page. -->
    <RadialGradientBrush x:Key="AccentGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3DFF9A02" Offset="0" />
        <GradientStop Color="#14FF9A02" Offset="0.45" />
        <GradientStop Color="#00FF9A02" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentPressedColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentHoverColor}" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
