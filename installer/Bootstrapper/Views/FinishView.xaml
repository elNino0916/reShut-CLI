<UserControl x:Class="reShutCLI.Bootstrapper.Views.FinishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:reShutCLI.Bootstrapper.Theme">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Ellipse Style="{StaticResource PageGlow}" Margin="0,90,0,0" />

            <StackPanel VerticalAlignment="Center" Margin="56,0">
                <Grid Height="68" HorizontalAlignment="Center">
                    <!-- A single ring expands away from the badge as it lands. -->
                    <Ellipse x:Name="Ring" Width="68" Height="68" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Border x:Name="Badge" Width="68" Height="68" CornerRadius="34" Background="{StaticResource AccentBrush}"
                            RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="28" ShadowDepth="0" Opacity="0.55" />
                        </Border.Effect>
                        <!--
                            The tick draws itself on. StrokeDashArray is measured in multiples of
                            StrokeThickness, so "10,10" at thickness 4 is a 40px dash - comfortably
                            longer than the ~37px path - and sliding the offset from 10 to 0 walks
                            the gap off the end of the stroke, revealing it from the start.
                        -->
                        <Path x:Name="Check" Data="M 0,9 L 9,18 L 26,0" Stroke="{StaticResource OnAccentBrush}"
                              StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              StrokeDashArray="10,10" StrokeDashOffset="10"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0"
                           theme:Reveal.Delay="0.4" />
                <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                           Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                           theme:Reveal.Delay="0.47" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FooterBar}" theme:Reveal.Delay="0.55" theme:Reveal.Rise="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14">
                <Button Content="Finish" Style="{StaticResource AccentButton}" Width="110" Click="OnFinishClick" />
            </StackPanel>
        </Border>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.2" />
                        <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="StrokeDashOffset"
                                         From="10" To="0" BeginTime="0:0:0.28" Duration="0:0:0.4">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                         From="0.6" To="0" BeginTime="0:0:0.22" Duration="0:0:0.8" />
                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1" To="1.8" BeginTime="0:0:0.22" Duration="0:0:0.8" />
                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1" To="1.8" BeginTime="0:0:0.22" Duration="0:0:0.8" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</UserControl>
