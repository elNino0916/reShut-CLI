<UserControl x:Class="reShutCLI.Bootstrapper.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:reShutCLI.Bootstrapper.Theme">
    <!--
        theme:Reveal.Delay staggers each element's fade-up so the page assembles itself
        top-to-bottom instead of appearing all at once. The values are seconds.
    -->
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Ellipse Style="{StaticResource PageGlow}" Margin="0,-62,0,0" />

            <StackPanel VerticalAlignment="Center" Margin="44,0">
                <Border Style="{StaticResource IconTile}" theme:Reveal.Delay="0">
                    <Image Source="{x:Static theme:AppIcon.Large}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <TextBlock Text="reShut CLI" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"
                           theme:Reveal.Delay="0.06" />
                <TextBlock Text="2.2.0  —  Shutdown, reboot and scheduling for Windows" FontSize="12.5"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,7,0,0"
                           theme:Reveal.Delay="0.12" />

                <TextBlock Text="INSTALL LOCATION" Style="{StaticResource SectionLabel}" Margin="0,32,0,7"
                           theme:Reveal.Delay="0.2" />
                <Grid theme:Reveal.Delay="0.25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" Height="34" HorizontalScrollBarVisibility="Hidden" />
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource LinkButton}" Height="34" Width="100" Margin="8,0,0,0" Click="OnBrowseClick" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="2,22,0,0" theme:Reveal.Delay="0.31">
                    <CheckBox x:Name="ShortcutCheck" Content="Create Start Menu shortcut" IsChecked="True" />
                    <CheckBox x:Name="LaunchCheck" Content="Launch when finished" Margin="32,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FooterBar}" theme:Reveal.Delay="0.37" theme:Reveal.Rise="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnCancelClick" />
                <Button Content="Install" Style="{StaticResource AccentButton}" Width="150" Height="38" FontSize="14" Margin="12,0,0,0" Click="OnInstallClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
