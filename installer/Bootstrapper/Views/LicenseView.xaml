<UserControl x:Class="reShutCLI.Bootstrapper.Views.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:reShutCLI.Bootstrapper.Theme">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,24,24,0" theme:Reveal.Delay="0">
            <TextBlock Text="License Agreement" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="Please review the terms before installing reShut CLI."
                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="24,16,24,0" CornerRadius="8" BorderThickness="1"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource FieldBorderBrush}"
                theme:Reveal.Delay="0.07">
            <ScrollViewer x:Name="LicenseScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="12" Focusable="False">
                <!--
                    Monospaced, and sized so the file's own hard wrap fits. The LICENSE is
                    pre-wrapped at 73 columns, and 73 Consolas advances at 10.5px come to
                    ~416px against ~434px of usable width. Wrapping stays on purely as a
                    safety net; at this size it never actually triggers. Any larger and every
                    long line folds, which orphans stubs and splits the ==== rulers in half.

                    Ideal formatting rather than the window-wide Display: Display rounds each
                    glyph advance to a whole pixel, which at this size inflates 73 columns
                    past the available width and reintroduces the wrapping.
                -->
                <TextBlock x:Name="LicenseText" FontFamily="Consolas" FontSize="10.5" LineHeight="15"
                           TextOptions.TextFormattingMode="Ideal"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <CheckBox x:Name="AcceptCheck" Grid.Row="2" Margin="24,14,24,14"
                  Content="I accept the terms of this license" Checked="OnAcceptChanged" Unchecked="OnAcceptChanged"
                  theme:Reveal.Delay="0.13" />

        <Border Grid.Row="3" Style="{StaticResource FooterBar}" theme:Reveal.Delay="0.19" theme:Reveal.Rise="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnCancelClick" />
                <!-- Enabled only once the checkbox is ticked; see OnAcceptChanged. -->
                <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource AccentButton}"
                        Width="130" Height="38" FontSize="14" Margin="12,0,0,0" IsEnabled="False" Click="OnContinueClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
